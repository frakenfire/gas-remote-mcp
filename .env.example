# Server Configuration
PORT=3000
MCP_BEARER_TOKEN=your_secure_mcp_bearer_token_here

# Google OAuth 2.0 Credentials
# Google Cloud Console > APIs & Services > Credentials에서 웹 애플리케이션 또는 데스크톱 앱으로 생성한 값
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google OAuth Refresh Token
# npm run auth 명령어를 수행하여 획득한 토큰값
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# Safety Constraints
# 수정을 허용할 Google Apps Script의 Script ID 목록 (쉼표로 구분)
# 예: ALLOWED_SCRIPT_IDS=1A_xxxx,1B_yyyy
ALLOWED_SCRIPT_IDS=your_allowed_script_id_1,your_allowed_script_id_2
